@page "/spectrum-pad"
@rendermode InteractiveServer

<h3>C1SpectrumPad</h3>

<div style="display:flex; gap:32px; align-items:flex-start; flex-wrap:wrap;">
    <div>
        <h5>@ColorPickerRes.SpectrumPad</h5>
        <C1SpectrumPad Color="@HslColor"
                       ColorChanged="@OnColorChanged"
                       Style="@PadStyle" />
    </div>

    <div style="min-width:320px;">
        <h5>@ColorPickerRes.Settings</h5>
        <div style="display:grid; gap:10px; max-width:340px;">
            <label>
                @ColorPickerRes.ColorAlpha
                <input class="form-range" type="range" min="0" max="255" @bind="Alpha" />
            </label>

            <label>
                @ColorPickerRes.ColorHue
                <input class="form-range" type="range" min="0" max="1" step="0.01" @bind="Hue" />
            </label>

            <label>
                @ColorPickerRes.ColorSaturation
                <input class="form-range" type="range" min="0" max="1" step="0.01" @bind="Saturation" />
            </label>

            <label>
                @ColorPickerRes.ColorLuminance
                <input class="form-range" type="range" min="0" max="1" step="0.01" @bind="Luminance" />
            </label>

            <label>
                @ColorPickerRes.StyleWidth
                <input class="form-control form-control-sm" type="number" min="160" max="420" step="10" @bind="_padWidth" />
            </label>

            <label>
                @ColorPickerRes.StyleHeight
                <input class="form-control form-control-sm" type="number" min="120" max="320" step="10" @bind="_padHeight" />
            </label>
        </div>

        <h5 style="margin-top:22px;">@ColorPickerRes.CurrentValue</h5>
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
            <div style="width:40px;height:40px;border:1px solid #ccc;border-radius:3px;background:@CssColor;"></div>
            <code>@CssColor</code>
        </div>
        <div style="display:grid; grid-template-columns:auto 1fr; gap:6px 12px; align-items:center; max-width:340px;">
            <span>@ColorPickerRes.ColorChanged</span>
            <code>@_colorChangedCount</code>
            <span>@ColorPickerRes.Alpha</span>
            <code>@Alpha</code>
            <span>@ColorPickerRes.Hue</span>
            <code>@Hue.ToString("0.00")</code>
            <span>@ColorPickerRes.Saturation</span>
            <code>@Saturation.ToString("0.00")</code>
            <span>@ColorPickerRes.Luminance</span>
            <code>@Luminance.ToString("0.00")</code>
        </div>
    </div>
</div>

@code {
    int _padWidth = 260;
    int _padHeight = 180;
    int _colorChangedCount;
    C1HslColor _hslColor = new(255, 0f, 1f, 0.5f);

    C1HslColor HslColor
    {
        get => _hslColor;
        set => _hslColor = value;
    }

    int Alpha
    {
        get => HslColor.Alpha;
        set => HslColor = new C1HslColor(ClampByte(value), HslColor.Hue, HslColor.Saturation, HslColor.Luminance);
    }

    double Hue
    {
        get => HslColor.Hue;
        set => HslColor = new C1HslColor(HslColor.Alpha, Clamp01(value), HslColor.Saturation, HslColor.Luminance);
    }

    double Saturation
    {
        get => HslColor.Saturation;
        set => HslColor = new C1HslColor(HslColor.Alpha, HslColor.Hue, Clamp01(value), HslColor.Luminance);
    }

    double Luminance
    {
        get => HslColor.Luminance;
        set => HslColor = new C1HslColor(HslColor.Alpha, HslColor.Hue, HslColor.Saturation, Clamp01(value));
    }

    C1Style PadStyle => new($"width:{_padWidth}px;height:{_padHeight}px;");
    C1Color PreviewColor => C1HslColor.ToColor(HslColor.Hue, HslColor.Saturation, HslColor.Luminance);
    string CssColor => $"rgba({PreviewColor.R}, {PreviewColor.G}, {PreviewColor.B}, {(HslColor.Alpha / 255d):0.###})";

    void OnColorChanged(C1HslColor color)
    {
        HslColor = color;
        _colorChangedCount++;
    }

    static byte ClampByte(int value)
    {
        return (byte)Math.Max(byte.MinValue, Math.Min(byte.MaxValue, value));
    }

    static float Clamp01(double value)
    {
        return (float)Math.Max(0d, Math.Min(1d, value));
    }
}
