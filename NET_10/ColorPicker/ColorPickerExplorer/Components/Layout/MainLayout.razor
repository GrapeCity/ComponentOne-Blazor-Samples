@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@ColorPickerRes.About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @ColorPickerRes.UnhandledError
    <a href="." class="reload">@ColorPickerRes.Reload</a>
    <span class="dismiss" title="@ColorPickerRes.Dismiss">&times;</span>
</div>
