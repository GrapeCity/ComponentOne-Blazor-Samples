@page "/FlexChart/Quadrants"
@using Localization
@using C1.Chart;
@using C1.Blazor.Chart;

<FlexChart @ref="chart" Class="chart" Tooltip="" HeaderStyle="font-size:20pt;">
    <Options>
        <ChartOptions BubbleMinSize="40" BubbleMaxSize="80" />
    </Options>
</FlexChart>

<_Sections>
    <Title>@FlexChartRes.QuadrantsTitle</Title>
    <Summary>@FlexChartRes.QuadrantsSummary</Summary>
    <Description>@FlexChartRes.QuadrantsDescription</Description>
</_Sections>

@code {
    FlexChart chart;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
            CreateLanguageMatrix(chart);
    }

    void CreateLanguageMatrix(FlexChart chart)
    {
        chart.BeginUpdate();

        var langs = new List<object> {
                // Fast & friendly (x>5, y>5)
                new { n = "Go", x = 7.5, y = 7.5, r = 20.0 },
                new { n = "Java", x = 6.5, y = 6.0, r = 22.0 },
                new { n = "Swift", x= 6.8, y= 7.2, r= 16.0 },
                new { n = "C#", x= 6.2, y= 6.8, r= 18.0 },
                // Bare metal (x>5, y<5)
                new { n = "Rust", x= 9.2, y= 4.5, r= 20.0 },
                new { n = "C++", x= 9.5, y= 2.5, r= 22.0 },
                new { n = "C", x = 9.0, y= 2.0, r= 18.0 },
                new { n = "Zig", x= 8.0, y= 4.2, r= 12.0 },
                // Approachable (x<5, y>5)
                new { n = "Python", x= 3.5, y = 9.0, r= 26.0 },
                new { n = "JavaScript", x= 4.0, y= 7.5, r= 24.0 },
                new { n= "Ruby", x= 2.8, y= 8.0, r= 16.0 },
                // Niche (x<5, y<5)
                new { n= "Perl", x= 3.2, y= 3.5, r= 14.0 },
                new { n= "Lua", x= 4.2, y= 4.0, r= 12.0 },
                new { n= "Tcl", x= 2.2, y= 2.4, r= 10.0 },
            };

        chart.HeaderContent = "Runtime performance vs ease of use, bubbles sized by adoption";

        chart.Binding = "y,r";
        chart.BindingX = "x";
        chart.ItemsSource = langs;

        chart.ChartType = ChartType.Bubble;

        chart.AxisX.Title = "Runtime Performance →";
        chart.AxisX.Min = 0;
        chart.AxisX.Max = 10;
        chart.AxisX.MajorTickMarks = TickMark.None;
        chart.AxisX.AxisLine = false;

        chart.AxisY.Title = "Ease of Use →";
        chart.AxisY.Min = 0;
        chart.AxisY.Max = 10;

        chart.AxisX.MajorGrid = chart.AxisY.MajorGrid = chart.AxisX.Labels = chart.AxisY.Labels = false;

        var zone1 = new RangeZone() { Style = "fill:#fff6e2;", Name = "Approachable", MaxX = 5, MinY = 5 };
        chart.Series.Add(zone1);

        var zone2 = new RangeZone() { Style = "fill:#f3f4f7;", Name = "Niche", MaxX = 5, MaxY = 5 };
        chart.Series.Add(zone2);

        var zone3 = new RangeZone() { Style = "fill:#e7f6ec", Name = "Fast & friendly", MinX = 5, MinY = 5 };
        chart.Series.Add(zone3);

        var zone4 = new RangeZone() { Style = "fill:#eaf0fb", Name = "Bare metal", MinX = 5, MaxY = 5 };
        chart.Series.Add(zone4);

        var series = new Series() { Style = "fill:#703b6fe0;" };
        chart.Series.Add(series);

        chart.DataLabel.Content = "{n}";
        chart.DataLabel.Position = LabelPosition.Center;

        chart.EndUpdate();
    }
}
