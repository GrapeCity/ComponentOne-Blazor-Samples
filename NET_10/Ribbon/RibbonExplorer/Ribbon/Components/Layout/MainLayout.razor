@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="main">
        <div class="top-row px-4">
            <a href="https://developer.mescius.com/componentone/docs/blazor/online-blazor/overview" target="_blank" rel="noopener noreferrer">@RibbonRes.Documentation</a>
        </div>

        <div class="content px-4">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
