@using C1.Diagram
@using C1.Blazor.Diagram
@implements IDisposable

<FlexDiagram @ref="diagram" Direction="DiagramDirection.LeftRight" EdgeRouting="EdgeRouting.SugiyamaSplines" />

@code {
    FlexDiagram? diagram;
    Random rnd = new Random();
    System.Timers.Timer timer = new(1000);
    uint[] palette = new uint[] { 0xfffbb4ae, 0xffb3cde3, 0xffccebc5, 0xffdecbe4, 0xfffed9a6, 0xffffffcc, 0xffe5d8bd, 0xfffddaec };

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            // draw custom shape
            diagram.NodeRendering += (s, e) =>
            {
                var d = diagram as IDiagram;
                var (left, top, width, height) = d.GetRect(e.Node);
                var index = d.GetNodes().IndexOf(e.Node);

                e.Engine.SetStrokeThickness(1);
                e.Engine.SetFill(unchecked((int)palette[index % palette.Length]));
                Tools.SampleTools.DrawBlob(e.Engine, left, top, width, height, index);
            };

            // dynamically create diagram
            timer.Elapsed += async (s, e) =>
            {

                await InvokeAsync(
                    () => {
                        diagram.BeginUpdate();

                        var nodes = diagram.Nodes;
                        var edges = diagram.Edges;

                        if (nodes.Count >= 20)
                        {
                            nodes.Clear();
                            edges.Clear();
                        }

                        nodes.Add(new Node()
                        {
                            Text = $"{nodes.Count}\n",
                            Shape = Shape.None,
                            TitleStyle = "stroke:black;fill:black;", //TitleStyle = new ChartStyle() { Stroke = Brushes.Black },
                            //NodeStyle = new ChartStyle() { Fill = palette[rnd.Next(0, palette.Count)] }
                        });

                        var i = rnd.Next(0, nodes.Count - 1);
                        if (i != nodes.Count - 1)
                            edges.Add(new Edge() { Source = nodes[i], Target = nodes[^1] });

                        diagram.EndUpdate();

                        StateHasChanged();
                    });
            };

            timer.Start();
        }
    }

    public void Dispose()
    {
        if (timer != null)
        {
            timer.Stop();
            timer.Dispose();
            timer = null;
        }
    }

}
